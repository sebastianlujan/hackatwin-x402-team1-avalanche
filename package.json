{
  "name": "hackatwin-x402-team1-avalanche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run --coverage --project default",
    "build": "pnpm -r --if-present build",
    "contracts:policy": "node packages/contracts/scripts/check-policy.ts",
    "fuji:tx": "bash packages/contracts/scripts/fuji-tx.sh",
    "quote": "node packages/pricing/scripts/quote.ts",
    "test:fork": "vitest run --project fork",
    "test:local": "vitest run --project local",
    "local:icm": "node e2e/protocol/src/local/icm-fetch.ts",
    "demo2:local:up": "node e2e/protocol/src/local/up.ts",
    "demo2": "node --env-file-if-exists=.cache/local-crosschain/dev/local.env --env-file-if-exists=.env demos/02-l1-crosschain/payment-agent/main.ts",
    "demo2:setup": "node --env-file=.cache/local-crosschain/dev/local.env demos/02-l1-crosschain/scripts/setup.ts",
    "web": "pnpm --filter @hackatwin/web dev",
    "web:demo1": "pnpm run \"/^(demo1:facilitator|demo1:seller|web)$/\"",
    "demo1": "node --env-file-if-exists=.demo1/demo1.env --env-file-if-exists=.env demos/01-x402-twin/buyer-agent/main.ts",
    "demo1:fork": "node --env-file-if-exists=.demo1/demo1.env --env-file-if-exists=.env demos/01-x402-twin/scripts/fork.ts",
    "demo1:fork-block": "node demos/01-x402-twin/scripts/fork-block.ts",
    "demo1:fund": "node --env-file-if-exists=.demo1/demo1.env --env-file-if-exists=.env demos/01-x402-twin/scripts/fund.ts",
    "demo1:facilitator": "node --env-file-if-exists=.demo1/demo1.env --env-file-if-exists=.env demos/01-x402-twin/facilitator/main.ts",
    "demo1:seller": "node --env-file-if-exists=.demo1/demo1.env --env-file-if-exists=.env demos/01-x402-twin/seller-api/main.ts",
    "demo1:register": "node --env-file-if-exists=.demo1/demo1.env --env-file-if-exists=.env demos/01-x402-twin/scripts/register.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
