{
  "name": "hackatwin-x402-team1-avalanche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run --coverage --project default",
    "build": "pnpm -r --if-present build",
    "chains:verify": "node packages/chains/scripts/verify.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
