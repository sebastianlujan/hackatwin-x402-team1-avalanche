{
  "name": "@hackatwin/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./abi/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "forge:build": "forge build",
    "test:contracts": "forge test",
    "test:bulloak:scaffold": "bulloak scaffold -s 0.8.30 -w 'test/**/*.tree'",
