{
  "name": "@hackatwin/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./abi/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "forge:build": "forge build",
    "test:contracts": "forge test",
    "test:bulloak:scaffold": "bulloak scaffold -s 0.8.30 -w 'test/**/*.tree'",
    "test:bulloak:check": "bulloak check 'test/**/*.tree'",
    "lint:fmt": "forge fmt --check",
    "lint:sol": "solhint 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol'",
    "lint:spec": "lintspec",
    "abi:export": "node scripts/export-abi.ts"
  },
  "devDependencies": {
    "@chainlink/contracts": "catalog:",
    "@chainlink/contracts-ccip": "catalog:",
    "@chainlink/local": "catalog:",
    "@openzeppelin/contracts": "catalog:",
    "@openzeppelin/contracts-4.8.3": "catalog:",
    "@openzeppelin/contracts-5.3.0": "catalog:",
    "forge-std": "catalog:",
    "solhint": "catalog:",
    "solhint-config-wonderland": "catalog:"
  }
}
